{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oats.dev/schemas/workspace-v1.json",
  "title": "Portable workspace definition v1",
  "description": "Data shape only; hosting identity, reciprocal membership and provider readiness are verified separately.",
  "type": "object",
  "required": ["schemaVersion", "name"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "members": { "type": "array", "items": { "$ref": "#/$defs/repository" } },
    "defaults": { "$ref": "https://oats.dev/schemas/soul-v1.json#/$defs/defaults" },
    "knowledge": {
      "type": "object", "required": ["stores"], "additionalProperties": false,
      "properties": { "stores": { "type": "array", "items": { "$ref": "https://oats.dev/schemas/soul-v1.json#/properties/knowledge" } } }
    },
    "teams": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/alias" },
      "properties": { "private": { "const": "per-human" } },
      "additionalProperties": {
        "type": "object", "required": ["provider", "id"], "additionalProperties": false,
        "properties": { "provider": { "$ref": "https://oats.dev/schemas/soul-v1.json#/$defs/capability" }, "id": { "type": "string", "minLength": 1 } }
      }
    },
    "catalogs": {
      "type": "array", "items": {
        "type": "object", "required": ["source"], "additionalProperties": false,
        "properties": { "source": { "$ref": "#/$defs/source" }, "revision": { "$ref": "#/$defs/revision" }, "path": { "$ref": "#/$defs/path" } }
      }
    },
    "imports": { "type": "array", "items": { "$ref": "#/$defs/import" } }
  },
  "$defs": {
    "source": { "type": "string", "pattern": "^git:.+$" },
    "revision": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1, "description": "Canonical contained repository-relative path; the shared source codec enforces semantic path rules." },
    "alias": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "repository": {
      "type": "object", "required": ["source"], "additionalProperties": false,
      "properties": { "source": { "$ref": "#/$defs/source" }, "revision": { "$ref": "#/$defs/revision" } }
    },
    "import": {
      "type": "object", "required": ["source", "soul", "revision", "alias"], "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "soul": { "$ref": "#/$defs/path" },
        "revision": { "$ref": "#/$defs/revision" },
        "alias": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "adoption": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "teamAliases": { "type": "object", "propertyNames": { "$ref": "#/$defs/alias" }, "additionalProperties": { "$ref": "#/$defs/alias" } },
            "providers": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "knowledge": { "$ref": "https://oats.dev/schemas/soul-v1.json#/$defs/defaultProvider" },
                "messaging": { "$ref": "https://oats.dev/schemas/soul-v1.json#/$defs/defaultProvider" },
                "tasks": { "$ref": "https://oats.dev/schemas/soul-v1.json#/$defs/defaultProvider" }
              }
            },
            "bindings": { "type": "object" }
          }
        }
      }
    }
  }
}
