{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oats.dev/schemas/portable-v1.json",
  "title": "Portable OATS shared wire values v1",
  "description": "Structural schemas only. Strict bounded decoding, canonical source/digest identities, cross-reference equality, constraints, provenance, graph limits and filesystem verification remain mandatory runtime checks. Provider payloads remain opaque; schema acceptance grants no trust, enrollment or privacy guarantee.",
  "$defs": {
    "Hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256-[a-f0-9]{64}$"
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
    },
    "RootRelativePath": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
        }
      ]
    },
    "CapabilityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "TreeIntegrity": {
      "type": "object",
      "properties": {
        "format": {
          "const": "oats.tree-exec.v1"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256-[a-f0-9]{64}$"
        }
      },
      "required": [
        "format",
        "value"
      ],
      "additionalProperties": false
    },
    "PackageIntegrity": {
      "type": "object",
      "properties": {
        "format": {
          "const": "oats.package-payload-exec.v1"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256-[a-f0-9]{64}$"
        }
      },
      "required": [
        "format",
        "value"
      ],
      "additionalProperties": false
    },
    "ByteIntegrity": {
      "type": "object",
      "properties": {
        "format": {
          "const": "oats.bytes.v1"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256-[a-f0-9]{64}$"
        }
      },
      "required": [
        "format",
        "value"
      ],
      "additionalProperties": false
    },
    "ResolutionRef": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256-[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "id"
      ],
      "additionalProperties": false
    },
    "RepositoryIdentity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "provider-repository"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9.-]*$"
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "provider",
            "host",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "canonical-remote"
            },
            "remote": {
              "type": "string",
              "minLength": 1,
              "pattern": "^git:.+$"
            }
          },
          "required": [
            "kind",
            "remote"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SoulIdentity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "git-soul"
            },
            "repository": {
              "$ref": "#/$defs/RepositoryIdentity"
            },
            "exportPath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
            }
          },
          "required": [
            "kind",
            "repository",
            "exportPath"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local-soul"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^path:/.*$"
            },
            "exportPath": {
              "oneOf": [
                {
                  "const": "."
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
                }
              ]
            }
          },
          "required": [
            "kind",
            "source",
            "exportPath"
          ],
          "additionalProperties": false
        }
      ]
    },
    "WorkspaceIdentity": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "path": {
          "const": "oats-workspace.yaml"
        }
      },
      "required": [
        "repository",
        "path"
      ],
      "additionalProperties": false
    },
    "CapabilityArtifactRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "capability"
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "integrity": {
          "$ref": "#/$defs/TreeIntegrity"
        }
      },
      "required": [
        "kind",
        "capability",
        "integrity"
      ],
      "additionalProperties": false
    },
    "SoulArtifactRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "soul"
        },
        "identity": {
          "$ref": "#/$defs/SoulIdentity"
        },
        "integrity": {
          "$ref": "#/$defs/TreeIntegrity"
        }
      },
      "required": [
        "kind",
        "identity",
        "integrity"
      ],
      "additionalProperties": false
    },
    "ResourceArtifactRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "resource"
        },
        "integrity": {
          "$ref": "#/$defs/TreeIntegrity"
        }
      },
      "required": [
        "kind",
        "integrity"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/CapabilityArtifactRef"
        },
        {
          "$ref": "#/$defs/SoulArtifactRef"
        },
        {
          "$ref": "#/$defs/ResourceArtifactRef"
        }
      ]
    },
    "ResourceRef": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "path": {
          "oneOf": [
            {
              "const": "."
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
            }
          ]
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "manifest",
            "skill",
            "runtime-package"
          ]
        }
      },
      "required": [
        "owner",
        "path",
        "kind"
      ],
      "additionalProperties": false
    },
    "OperatorDocument": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "operator"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "SourceDocument": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "source"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^git:.+$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
            },
            "integrity": {
              "$ref": "#/$defs/ByteIntegrity"
            }
          },
          "required": [
            "kind",
            "source",
            "revision",
            "path",
            "integrity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "source"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^path:/.*$"
            },
            "revision": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
            },
            "integrity": {
              "$ref": "#/$defs/ByteIntegrity"
            }
          },
          "required": [
            "kind",
            "source",
            "revision",
            "path",
            "integrity"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DeploymentDocument": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "deployment"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
        },
        "integrity": {
          "$ref": "#/$defs/ByteIntegrity"
        }
      },
      "required": [
        "kind",
        "path",
        "integrity"
      ],
      "additionalProperties": false
    },
    "RecordDocument": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "record"
        },
        "ref": {
          "$ref": "#/$defs/ResolutionRef"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "ArtifactDocument": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "owner": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
        },
        "integrity": {
          "$ref": "#/$defs/ByteIntegrity"
        }
      },
      "required": [
        "kind",
        "owner",
        "path",
        "integrity"
      ],
      "additionalProperties": false
    },
    "Origin": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "soul-requirement",
            "soul-default",
            "workspace-default",
            "import-adoption",
            "operator",
            "package-dependency",
            "work-target",
            "migration-evidence",
            "provider-binding",
            "workspace-admission",
            "member-backlink",
            "source-export",
            "manifest-default"
          ]
        },
        "document": {
          "oneOf": [
            {
              "$ref": "#/$defs/SourceDocument"
            },
            {
              "$ref": "#/$defs/DeploymentDocument"
            },
            {
              "$ref": "#/$defs/OperatorDocument"
            },
            {
              "$ref": "#/$defs/RecordDocument"
            },
            {
              "$ref": "#/$defs/ArtifactDocument"
            }
          ]
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        },
        "span": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "document",
        "pointer"
      ],
      "additionalProperties": false
    },
    "OperatorOrigin": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "operator"
        },
        "document": {
          "$ref": "#/$defs/OperatorDocument"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        },
        "span": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "document",
        "pointer"
      ],
      "additionalProperties": false
    },
    "Constraint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "equals"
            },
            "value": {},
            "origin": {
              "$ref": "#/$defs/Origin"
            }
          },
          "required": [
            "kind",
            "value",
            "origin"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "required"
            },
            "origin": {
              "$ref": "#/$defs/Origin"
            }
          },
          "required": [
            "kind",
            "origin"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Considered": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "manifest-default",
            "workspace-default",
            "soul-default",
            "import-adoption",
            "operator"
          ]
        },
        "value": {},
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "disposition": {
          "enum": [
            "selected",
            "overridden"
          ]
        }
      },
      "required": [
        "kind",
        "value",
        "origin",
        "disposition"
      ],
      "additionalProperties": false
    },
    "Choice": {
      "type": "object",
      "properties": {
        "value": {},
        "selectedBy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Origin"
            }
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "considered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Considered"
          }
        }
      },
      "required": [
        "value",
        "selectedBy",
        "constraints",
        "considered"
      ],
      "additionalProperties": false
    },
    "GitObservation": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "remote": {
          "type": "string",
          "minLength": 1,
          "pattern": "^git:.+$"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Origin"
          },
          "minItems": 1
        }
      },
      "required": [
        "identity",
        "remote",
        "selector",
        "commit",
        "provenance"
      ],
      "additionalProperties": false
    },
    "LocalObservation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "local"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^path:/.*$"
        },
        "integrity": {
          "$ref": "#/$defs/TreeIntegrity"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Origin"
          },
          "minItems": 1
        },
        "repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        }
      },
      "required": [
        "kind",
        "source",
        "integrity",
        "provenance"
      ],
      "additionalProperties": false
    },
    "SoulSelection": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/SoulIdentity"
        },
        "revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/GitObservation"
            },
            {
              "$ref": "#/$defs/LocalObservation"
            }
          ]
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceArtifact": {
          "$ref": "#/$defs/SoulArtifactRef"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
        },
        "projection": {
          "type": "object",
          "properties": {
            "roots": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "const": "."
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
                  }
                ]
              },
              "uniqueItems": true,
              "minItems": 1,
              "description": "Set in canonical UTF-8 order; runtime verifies closure and witnesses."
            }
          },
          "required": [
            "roots"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "identity",
        "revision",
        "alias",
        "sourceArtifact",
        "definition",
        "projection"
      ],
      "additionalProperties": false
    },
    "PackageRow": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:git:.+|path:/.*|catalog:.+)$"
        },
        "path": {
          "oneOf": [
            {
              "const": "."
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "const": "local"
            }
          ]
        },
        "integrity": {
          "$ref": "#/$defs/PackageIntegrity"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "path",
        "version",
        "commit",
        "integrity",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "CapabilityOrigin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "package"
            },
            "package": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "path": {
              "oneOf": [
                {
                  "const": "."
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\u0000]+(?:/[^/\\\\\u0000]+)*$"
                }
              ]
            },
            "projectionVersion": {
              "const": 1
            }
          },
          "required": [
            "kind",
            "package",
            "path",
            "projectionVersion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local-capability"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^path:/.*$"
            },
            "authoredAs": {
              "enum": [
                "owned",
                "path"
              ]
            },
            "witness": {
              "$ref": "#/$defs/Origin"
            }
          },
          "required": [
            "kind",
            "source",
            "authoredAs",
            "witness"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CapabilityRow": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/CapabilityArtifactRef"
        },
        "origin": {
          "$ref": "#/$defs/CapabilityOrigin"
        }
      },
      "required": [
        "version",
        "artifact",
        "origin"
      ],
      "additionalProperties": false
    },
    "ArtifactSet": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PackageRow"
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CapabilityRow"
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "schemaVersion",
        "packages",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "CredentialRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
