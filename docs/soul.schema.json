{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oats.dev/schemas/soul-v2.json",
  "title": "Soul declaration v2 (soul.yaml)",
  "description": "Authored shape only. A soul names each capability WITH WHERE IT COMES FROM (`from: here | <repo key> | package`) — a location, never a version. Provider payloads (knowledge, messaging, tasks) are opaque to the kernel; `none` empties the slot. Membership, privacy and team semantics are enforced by discovery/resolution, not here.",
  "type": "object",
  "required": ["schemaVersion", "name", "description", "work"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "name": { "$ref": "#/$defs/slug" },
    "description": { "type": "string" },
    "work": { "enum": ["worktree", "checkout", "directory", "workspace"] },
    "team": { "$ref": "#/$defs/label", "description": "Team label; overrides the repo's default from oats-membership.yaml." },
    "private": { "type": "boolean", "description": "true → not discoverable in the workspace; usable only from its own repo." },
    "capabilities": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/capabilityName" },
      "additionalProperties": { "$ref": "#/$defs/capabilityChoice" }
    },
    "knowledge": { "$ref": "#/$defs/slotPayload" },
    "messaging": { "$ref": "#/$defs/slotPayload" },
    "tasks": { "$ref": "#/$defs/slotPayload" },
    "compatibility": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/capabilityName" },
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "Optional FLOORS on package versions (semver ranges) — constraints, not sources."
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "label": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "capabilityName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "repoKey": { "type": "string", "pattern": "^[^\\s@/][^\\s@]*/[^\\s@]+$" },
    "fromLocation": {
      "anyOf": [
        { "const": "package" },
        { "const": "here" },
        { "$ref": "#/$defs/repoKey" }
      ]
    },
    "capabilityRef": {
      "type": "object",
      "required": ["from"],
      "additionalProperties": false,
      "properties": { "from": { "$ref": "#/$defs/fromLocation" } }
    },
    "capabilityChoice": { "anyOf": [{ "$ref": "#/$defs/capabilityRef" }, { "const": "off" }] },
    "slotPayload": {
      "anyOf": [{ "const": "none" }, { "type": "object" }],
      "description": "Opaque provider payload, or `none` to leave the slot empty."
    }
  }
}
