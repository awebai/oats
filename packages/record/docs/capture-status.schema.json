{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capture status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "lastRun",
    "lastSuccess",
    "lastFailure",
    "lastProgressAt",
    "backlog"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "type": "null",
      "description": "No policy or run evidence supplied in the algorithm-only phase."
    },
    "lastRun": {
      "type": "null",
      "description": "No policy or run evidence supplied in the algorithm-only phase."
    },
    "lastSuccess": {
      "type": "null",
      "description": "No policy or run evidence supplied in the algorithm-only phase."
    },
    "lastFailure": {
      "type": "null",
      "description": "No policy or run evidence supplied in the algorithm-only phase."
    },
    "lastProgressAt": {
      "type": "null",
      "description": "No policy or run evidence supplied in the algorithm-only phase."
    },
    "backlog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending",
        "setAsideCount",
        "setAside",
        "truncated"
      ],
      "properties": {
        "pending": {
          "type": "boolean"
        },
        "setAsideCount": {
          "type": "integer",
          "minimum": 0
        },
        "setAside": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "path",
              "offset",
              "reason"
            ],
            "properties": {
              "source": {
                "enum": [
                  "aw",
                  "cc",
                  "pi",
                  "codex"
                ]
              },
              "path": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "failedCount": {
          "type": "integer",
          "minimum": 0
        },
        "failedTruncated": {
          "type": "boolean"
        },
        "failed": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stream",
              "offset",
              "reason",
              "attempts",
              "nextRetryAt"
            ],
            "properties": {
              "stream": {
                "type": "string",
                "minLength": 1
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "description": "Journal byte offset at the start of the durably admitted failed single-stream unit; not an exact failing-frame location."
              },
              "reason": {
                "enum": [
                  "heap",
                  "rss",
                  "deadline",
                  "interrupted",
                  "io"
                ]
              },
              "attempts": {
                "type": "integer",
                "minimum": 1
              },
              "nextRetryAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "description": "Operational failure fields are absent in algorithm-phase snapshots; absence is no recorded evidence, never proof of success. Each category has its own 100-entry sample.",
      "dependentRequired": {
        "failedCount": [
          "failed",
          "failedTruncated"
        ],
        "failed": [
          "failedCount",
          "failedTruncated"
        ],
        "failedTruncated": [
          "failedCount",
          "failed"
        ]
      }
    }
  }
}
