    "executable": "#!/usr/bin/env node\nimport { readFileSync, writeFileSync, existsSync } from \"node:fs\";\nconst [cmd = \"teams\", ...rest] = process.argv.slice(2);\nconst home = process.env.OATS_INSTANCE_HOME || process.cwd(), state = home + \"/.nw-teams.json\";\nconst MAPPED = { dev: \"northwind:eng\", reviewers: \"northwind:review\" }, RECEIVE = { dev: \"poll\", reviewers: \"native\" };\nconst joined = existsSync(state) ? JSON.parse(readFileSync(state, \"utf8\")) : [];\nconst out = v => { process.stdout.write(JSON.stringify(v) + \"\\n\"); };\nconst fail = (code, message) => { out({ schemaVersion: 1, ok: false, error: { code, message } }); process.exit(1); };\nconst doc = () => ({ defaultTeam: { team: \"default:northwind:alice\", source: \"root\" }, primary: \"dev\",\n  eligible: Object.entries(MAPPED).map(([label, team]) => ({ label, team, joined: joined.some(j => j.label === label) })),\n  joined: joined.map(j => ({ ...j })), unmapped: [\"marketing\"], at: \"2026-09-25T10:00:00.000Z\" });\nif (cmd === \"teams\") { out({ schemaVersion: 1, ok: true, result: doc() }); process.exit(0); }\nconst i = rest.indexOf(\"--labels\"), labels = (i >= 0 ? rest[i + 1] ?? \"\" : \"\").split(\",\").filter(Boolean);\nif (!labels.length) fail(\"E_BAD_ARGS\", \"name at least one team label\");\nif (cmd === \"leave\" && labels.includes(\"default\")) fail(\"E_TEAM_DEFAULT\", \"the workspace's default team cannot be left\");\nconst bad = labels.filter(l => !Object.hasOwn(MAPPED, l));\nif (bad.length) fail(\"E_TEAM_NOT_ELIGIBLE\", \"not eligible: \" + bad.join(\", \") + \" (eligible: \" + Object.keys(MAPPED).join(\", \") + \")\");\nlet next = joined;\nif (cmd === \"join\") for (const label of labels) if (!next.some(j => j.label === label))\n  next = [...next, { label, team: MAPPED[label], since: \"2026-09-25T10:0\" + next.length + \":00.000Z\", identityHome: home + \"/.aweb-identity-\" + label, receive: RECEIVE[label] }];\nif (cmd === \"leave\") next = next.filter(j => !labels.includes(j.label));\nwriteFileSync(state, JSON.stringify(next));\njoined.splice(0, joined.length, ...next);\nout({ schemaVersion: 1, ok: true, result: doc() });\n",
